{
  "contract": "Frames from hivemind-bus-client's own encoder. A BINARY frame's payload is bytes; every other type binarized on the wire is still JSON.",
  "cases": [
    {
      "name": "rendered speech carries what was said",
      "frame": "",
      "expected_kind": "tts_audio",
      "expected_metadata": {
        "utterance": "Pfffft.",
        "lang": "fr-FR",
        "file_name": "prout.wav"
      },
      "expected_payload": ""
    },
    {
      "name": "a file carries only its name",
      "frame": "",
      "expected_kind": "file",
      "expected_metadata": {
        "file_name": "notes.txt"
      },
      "expected_payload": ""
    },
    {
      "name": "an empty name is no name",
      "frame": "",
      "expected_kind": "file",
      "expected_metadata": {
        "file_name": ""
      },
      "expected_payload": ""
    },
    {
      "name": "a payload type nobody named arrives under its number",
      "frame": "",
      "expected_kind": "binary:0",
      "expected_metadata": {},
      "expected_payload": ""
    },
    {
      "name": "payload type 1 is raw_audio",
      "frame": "",
      "expected_kind": "raw_audio",
      "expected_metadata": {
        "file_name": "raw_audio.bin"
      },
      "expected_payload": ""
    },
    {
      "name": "payload type 2 is numpy_image",
      "frame": "",
      "expected_kind": "numpy_image",
      "expected_metadata": {
        "file_name": "numpy_image.bin"
      },
      "expected_payload": ""
    },
    {
      "name": "payload type 3 is file",
      "frame": "",
      "expected_kind": "file",
      "expected_metadata": {
        "file_name": "file.bin"
      },
      "expected_payload": ""
    },
    {
      "name": "payload type 4 is stt_transcribe",
      "frame": "",
      "expected_kind": "stt_transcribe",
      "expected_metadata": {
        "file_name": "stt_transcribe.bin"
      },
      "expected_payload": ""
    },
    {
      "name": "payload type 5 is stt_handle",
      "frame": "",
      "expected_kind": "stt_handle",
      "expected_metadata": {
        "file_name": "stt_handle.bin"
      },
      "expected_payload": ""
    },
    {
      "name": "payload type 6 is tts_audio",
      "frame": "",
      "expected_kind": "tts_audio",
      "expected_metadata": {
        "file_name": "tts_audio.bin"
      },
      "expected_payload": ""
    },
    {
      "name": "compressed metadata still reads, and the clip is never inflated",
      "frame": "",
      "expected_kind": "tts_audio",
      "expected_metadata": {
        "lang": "fr-FR",
        "file_name": "prout.wav",
        "utterance": "Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. Pfffft. "
      },
      "expected_payload": ""
    }
  ],
  "bus_frame": "wEICe317InR5cGUiOiAic3BlYWsiLCAiZGF0YSI6IHsidXR0ZXJhbmNlIjogIlBmZmZmdC4ifX0="
