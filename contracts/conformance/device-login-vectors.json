   "name": "begin asks for the scopes and names the client",
   "call": {
    "op": "begin",
    "scopes": [
     "hubs:read",
     "clients:read",
     "clients:write"
    ],
    "client_name": "Home Assistant"
   },
   "exchanges": [
    {
     "request": {
      "method": "POST",
      "path": "/v1/auth/device/authorize",
      "json": {
       "scopes": [
        "hubs:read",
        "clients:read",
        "clients:write"
       ],
       "client_name": "Home Assistant"
      }
     },
     "response": {
      "status": 200,
      "content_type": "application/json",
      "body": "{\"device_code\":\"dc-5f0c2d4e8a614c1f9d2b3e7a9c0b1f24\",\"user_code\":\"WDJB-MJHT\",\"verification_uri\":\"https://thalovant.com/activate\",\"verification_uri_complete\":\"https://thalovant.com/activate?code=WDJB-MJHT\",\"expires_in\":900,\"interval\":5}"
     }
    }
   ],
   "expect": [
    {
     "outcome": "started",
     "user_code": "WDJB-MJHT",
     "verification_uri": "https://thalovant.com/activate",
     "verification_uri_complete": "https://thalovant.com/activate?code=WDJB-MJHT",
     "interval": 5,
     "expires_in": 900
    }
   ]
  },
