      "scope": {
        "thalovant-dotnet-sdk": {
          "status": "required"
        },
        "thalovant-embedded-c": {
          "reason": "src/wire.c decodes JSON frames, not WIRE-1 bitstrings, so there is no bit reader to extend; the type-code table already knows bin=12. The real blocker is zlib: the encoder chooses per frame whether to compress the metadata, and taking a compression dependency into a -std=c99 -pedantic microcontroller target is a decision about this SDK's footprint rather than about parity. The clip itself is never compressed, so a decoder that refused compressed metadata would still deliver audio.",
          "status": "not-applicable"
        },
