    "home-link": {
      "description": "The Home Assistant link on the data plane: every thalovant.home.request is answered with one thalovant.home.response, sent as an OVOS-MSG-1 §5.2 reply built from the context as the hub sent it (deep copy, destination the old source, source the old destination's first entry), in plain text, within the hub's 10 s; response_type and error_code come from the contract's lists, and a handler that raises, is too slow or answers outside them is failed_to_handle, timeout or unknown with empty speech. A long-lived link reconnects on a ladder, treats refusals as not-yet-admitted for a grace period, and reads a close right after the handshake as a refusal.",
      "files": [
        "src/thalovant/home.py",
        "src/thalovant/client.py",
        "src/thalovant/session.py",
        "src/thalovant/_hive.py"
      ],
      "scope": {
        "thalovant-dotnet-sdk": {
          "status": "required"
        },
        "thalovant-embedded-c": {
          "reason": "Embedded C is a caller-buffer wire library: the caller owns the socket, the loop and every handler, so there is no connection of the library's own on which to answer a request. The caller builds the reply from the request it holds.",
          "status": "not-applicable"
        },
        "thalovant-go-sdk": {
          "status": "required"
        },
        "thalovant-kotlin-sdk": {
          "status": "required"
        },
        "thalovant-mcp": {
          "reason": "An MCP tool call holds a hub connection only for the length of that call, and MCP has no channel to deliver an unsolicited hub request to a model, so nothing could answer one.",
          "status": "not-applicable"
        },
        "thalovant-node-sdk": {
          "status": "required"
        },
        "thalovant-python-sdk": {
          "status": "required"
        },
        "thalovant-rust-sdk": {
          "status": "required"
        },
        "thalovant-swift-sdk": {
          "status": "required"
        }
      },
      "tests": [
        "tests/test_home_link_vectors.py",
        "tests/test_async_hub_session.py"
